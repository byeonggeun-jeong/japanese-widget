{
  "name": "kana-widget",
  "version": "1.2.0",
  "private": true,
  "description": "바탕화면용 히라가나/가타가나 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-packager . JapaneseWidget --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=icon.ico --ignore=\"^/icon\\.(ico|icns)$\" --ignore=\"^/mac-info\\.plist$\" --ignore=\"\\.test\\.js$\" --ignore=\"\\.lnk$\" --ignore=\"^/README\\.md$\"",
    "pack:mac": "electron-packager . JapaneseWidget --platform=darwin --arch=universal --out=dist --overwrite --asar --icon=icon.icns --app-bundle-id=com.byeonggeun.kanawidget --extend-info=mac-info.plist --ignore=\"^/icon\\.(ico|icns)$\" --ignore=\"^/mac-info\\.plist$\" --ignore=\"\\.test\\.js$\" --ignore=\"\\.lnk$\" --ignore=\"^/README\\.md$\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  }
}
